# Rust build artifacts
/target/
/wasm/target/
/wasm/pkg/
debug/
*.pdb

# Cargo lock (optional for libraries)
Cargo.lock
!/wasm/Cargo.lock

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test files
*.pdf
!tests/fixtures/*.pdf
# Prodeen eval corpus fixtures (see evals/README.md). Note `scripts/` below
# matches at any depth, which is why the eval helpers live in evals/tools/.
!evals/pdfs/*.pdf

# Build cache
**/*.rs.bk

# NAPI generated (regenerated by `napi prepublish` during CI)
napi/index.js
napi/index.d.ts

# Local samples and scripts
samples/
scripts/

# Test output
test_output/
.firecrawl/

# Eval candidate markdown is regenerated by every run; goldens are the artifact
evals/candidate/

# Python
__pycache__/
*.pyc
.pytest_cache/
